NODE_ENV=development
PORT=5001

GEMINI_API_KEY=

MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

VECTOR_DB_PROVIDER=
VECTOR_DB_URL=

# HMAC secret used to sign/verify JWTs. Must be a long random string, unique
# per environment — never reuse the same secret across dev/staging/prod.
JWT_SECRET=

# Set to "true" to let the evaluation harness run its LLM-driven categories
# (spends real Gemini quota). See evaluation/README.md.
EVAL_LIVE_CALLS_ENABLED=false
