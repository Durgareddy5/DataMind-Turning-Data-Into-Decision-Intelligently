# Template for staging. Copy to .env.staging and fill in real values —
# never reuse development's credentials, DB user, or JWT_SECRET here.
NODE_ENV=staging
PORT=5001

GEMINI_API_KEY=

MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

VECTOR_DB_PROVIDER=
VECTOR_DB_URL=

JWT_SECRET=

EVAL_LIVE_CALLS_ENABLED=false
